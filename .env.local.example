# Optional overrides for docker-compose.local.yml.
#
# The compose file runs with safe RustFS defaults without this file. Copy this
# file to `.env.local` only when you want to use a separate Cloudflare R2
# staging account; `.env.local` is gitignored.
#
#   cp .env.local.example .env.local

# --- Cloudflare R2 (see CI-CD.md "R2 Storage") ---
# Use a SEPARATE R2 API token + buckets from production. Running this compose
# file with production bucket names is a real risk: publish_problem_release
# would overwrite releases judges are currently grading from, and local
# uploads would land in the production media bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_MEDIA_BUCKET=thinkcode-media-staging
R2_PROBLEMS_BUCKET=thinkcode-problems-staging
# Leave unset unless the staging bucket has its own public custom domain --
# without one, django-storages falls back to presigned R2 endpoint URLs,
# which still work fine for local testing.
R2_MEDIA_CUSTOM_DOMAIN=
R2_MEDIA_URL_PROTOCOL=https:
R2_MEDIA_PRIVATE=False

# --- Everything below has a working default; override only if you need to ---
# DJANGO_SECRET_KEY=some-other-local-only-value
# DB_ROOT_PASSWORD=root
# DB_PASSWORD=root
